# Copy to .env for local runs. Never commit .env.
PORT=3001
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Leave the four COGNITO_ values empty: local.js reads them from
# ../leave-request-service/deploy/cognito-outputs.json
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_JWKS_URL=
CORS_ORIGIN=http://localhost:8080
# Local only. In Lambda the URL comes from Secrets Manager (secret: leaveflow/approvals).
DATABASE_URL=
SECRET_NAME=leaveflow/approvals
EVENT_BUS_NAME=leaveflow-bus
NOTIFY_TOPIC_ARN=
ESCALATION_STATE_MACHINE_ARN=
# true = escalate after 2 minutes (demo); false = 48 hours
DEMO_MODE=true
