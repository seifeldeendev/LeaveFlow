{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "OwnLogsOnly", "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/approvals-fn:*" },
    { "Sid": "ReadOwnDatabaseSecret", "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:__REGION__:__ACCOUNT__:secret:leaveflow/approvals-*" },
    { "Sid": "PublishToSharedBus", "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:__REGION__:__ACCOUNT__:event-bus/leaveflow-bus" },
    { "Sid": "ReadUsersForCoverageAndHrOnly", "Effect": "Allow",
      "Action": ["cognito-idp:ListUsers", "cognito-idp:ListUsersInGroup"],
      "Resource": "arn:aws:cognito-idp:__REGION__:__ACCOUNT__:userpool/__POOL_ID__" },
    { "Sid": "PublishNotificationsOnly", "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:__REGION__:__ACCOUNT__:leaveflow-notifications" },
    { "Sid": "StartEscalationTimerOnly", "Effect": "Allow",
      "Action": "states:StartExecution",
      "Resource": "arn:aws:states:__REGION__:__ACCOUNT__:stateMachine:leave-approval-escalation" }
  ]
}
