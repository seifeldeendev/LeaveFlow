# Copy to .env for local runs. Never commit .env.
PORT=3000
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_JWKS_URL=
CORS_ORIGIN=http://localhost:8080
# Local only. In Lambda the URL comes from Secrets Manager (secret: leaveflow/requests).
DATABASE_URL=
SECRET_NAME=leaveflow/requests
EVENT_BUS_NAME=leaveflow-bus
BALANCE_PROJECTION_FN=balance-projection-fn
# Local only, until Seif's balance-projection-fn exists. Never 'off' in Lambda.
BALANCE_CHECK=
CERT_BUCKET=leaveflow-certificates
CERT_KMS_KEY_ID=
