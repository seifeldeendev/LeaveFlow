{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "OwnLogsOnly", "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT__:log-group:/aws/lambda/requests-fn:*" },
    { "Sid": "ReadOwnDatabaseSecret", "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:__REGION__:__ACCOUNT__:secret:leaveflow/requests-*" },
    { "Sid": "PublishToSharedBus", "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:__REGION__:__ACCOUNT__:event-bus/leaveflow-bus" },
    { "Sid": "AskBalanceServiceOnly", "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:__REGION__:__ACCOUNT__:function:balance-projection-fn" },
    { "Sid": "CertificatesFolderOnly", "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::leaveflow-certificates/certificates/*" },
    { "Sid": "UseCertificateKeyOnly", "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": "__KMS_KEY_ARN__" }
  ]
}
